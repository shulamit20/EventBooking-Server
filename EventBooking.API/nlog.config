<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/logs/internal-nlog.txt">

  <!-- Layout renderers from NLog.Web (e.g. ${aspnet-request-method}). -->
  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <targets>
    <!-- Everything, in full, to one file per day. cid = the request's correlation id
         (set by CorrelationIdMiddleware via ILogger.BeginScope). -->
    <target xsi:type="File" name="file"
            fileName="${basedir}/logs/eventbooking-${shortdate}.log"
            layout="${longdate} | ${level:uppercase=true:padding=-5} | cid=${scopeproperty:item=CorrelationId:whenEmpty=-} | ${logger} | ${message} ${onexception:${newline}${exception:format=tostring}}" />

    <!-- Compact line for the console during local runs. -->
    <target xsi:type="Console" name="console"
            layout="${time} | ${level:uppercase=true:padding=-5} | cid=${scopeproperty:item=CorrelationId:whenEmpty=-} | ${message} ${onexception:${exception:format=shorttype,message}}" />
  </targets>

  <rules>
    <!-- Keep the hosting lifetime lines ("Now listening on...", "Application started"). -->
    <logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="file,console" final="true" />

    <!-- Other framework noise (incl. EF Core SQL): keep only Warning and above. -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />

    <!-- Our code: Debug and above to the file, Info and above to the console. -->
    <logger name="*" minlevel="Debug" writeTo="file" />
    <logger name="*" minlevel="Info" writeTo="console" />
  </rules>
</nlog>
